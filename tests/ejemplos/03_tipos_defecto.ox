fn main() {
    let entero: i32 = 10;
    let decimal: f64 = 3.14;
    let contador: i32;
    let promedio: f64;
    let activo: bool;
    let mensaje: String;
    println!("{}", entero);
    println!("{}", decimal);
    println!("{}", contador);
    println!("{}", promedio);
    println!("{}", activo);
    println!("{}", mensaje);
}
